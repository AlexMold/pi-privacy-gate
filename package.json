{
  "name": "pi-privacy-gate",
  "version": "0.2.0",
  "description": "Privacy gate for Pi: local PII detection, span redaction, file withholding, and local-model analysis. Cloud orchestrates, private content stays local.",
  "license": "MIT",
  "type": "module",
  "author": "Alexandr Gribcov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexMold/pi-privacy-gate.git"
  },
  "homepage": "https://github.com/AlexMold/pi-privacy-gate#readme",
  "bugs": "https://github.com/AlexMold/pi-privacy-gate/issues",
  "keywords": [
    "pi-package",
    "privacy",
    "pii",
    "llm",
    "redaction"
  ],
  "files": [
    "extensions/",
    "src/",
    "docs/adr/",
    "docs/detector-spike-report.md",
    "README.md",
    "LICENSE",
    "SPEC.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/AlexMold/pi-privacy-gate/main/docs/media/poster.jpg",
    "video": "https://raw.githubusercontent.com/AlexMold/pi-privacy-gate/main/docs/media/demo.mp4"
  },
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "lint:claims": "node scripts/lint-claims.ts",
    "bench:fetch": "node scripts/fetch-piitrace.ts",
    "bench:piitrace": "node scripts/benchmark.ts",
    "egress:proof": "node scripts/egress-proof.ts"
  }
}
